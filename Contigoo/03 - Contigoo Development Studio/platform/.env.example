# SERVER-ONLY. Copy outside public files, restrict access, and fill privately.
CONTIGOO_ENV=production
# For Studio use studio; generated packages set delivered.
APP_MODE=studio
APP_ORIGIN=https://studio.example.invalid
HOST=127.0.0.1
PORT=4300
# Set only after validating the real reverse-proxy topology.
TRUST_PROXY_HOPS=1
DATABASE_URL=
IDENTITY_DATABASE_URL=
AUTH_SECRET=
OWNER_SETUP_TOKEN=
# For a private PostgreSQL CA, configure NODE_EXTRA_CA_CERTS before starting Node.
# Migration credentials belong only in the separate migration environment file.
