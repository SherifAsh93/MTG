{
  "name": "contigoo-studio-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "setup": "node dist/setup.js",
    "test": "node --test test/*.test.mjs",
    "test:package-startup": "node test/verify-package-startup.mjs",
    "test:restore": "node test/verify-restore.mjs",
    "dev:start": "node scripts/dev-server.mjs",
    "dev:stop": "node scripts/dev-server.mjs --stop"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "better-auth": "1.7.5",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "libphonenumber-js": "1.13.13",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
